# Optional overrides. Put a copy named .env in the data folder:
#   - cloned repo: backend/.env
#   - downloaded app: the app-data folder shown in the startup window
# Real environment variables override this file.
# Credentials (Gmail, Groq) are configured in the app's Settings page, not here.

# Port for the app (run.py / the downloaded app). Default 8765.
# PORT=8765

# Dev server only (python run.py --dev / python app.py): debug mode with auto-reload
# FLASK_DEBUG=1

# Where data lives
# OUTREACH_DB_PATH=/path/to/outreach.db
# OUTREACH_CONFIG_PATH=/path/to/config.json
# OUTREACH_UPLOAD_DIR=/path/to/uploads

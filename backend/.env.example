# Copy to backend/.env and adjust. Real environment variables override this file.
# Credentials (Gmail, Groq) are configured in the app's Settings page, not here.

# Flask debug mode with auto-reload (1) or production-style (0)
FLASK_DEBUG=1

# Port for the API (the Vite dev server proxies /api to 5000)
PORT=5000

# Where data lives (defaults: files next to app.py)
# OUTREACH_DB_PATH=/path/to/outreach.db
# OUTREACH_CONFIG_PATH=/path/to/config.json
# OUTREACH_UPLOAD_DIR=/path/to/uploads
